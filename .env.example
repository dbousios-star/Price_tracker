# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you need.
# `.env` is git-ignored. In GitHub Actions the same names are supplied as
# repository secrets (see README section 5).
# ---------------------------------------------------------------------------

# --- Telegram (optional) ---------------------------------------------------
# Create a bot with @BotFather, then send it one message and read the chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord (optional) ----------------------------------------------------
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# --- Storage ---------------------------------------------------------------
# Relative paths are resolved against the project root.
DB_PATH=tracker.db
TARGETS_FILE=targets.json

# --- Alert behaviour -------------------------------------------------------
# Minimum absolute percentage change required before an alert is sent.
# 0 = alert on any change. 5 = only alert on changes of 5% or more.
ALERT_THRESHOLD_PCT=0

# Send a notification when the price goes up (default: yes).
NOTIFY_ON_INCREASE=true

# Send a "tracking started" notification the first time a URL is seen.
NOTIFY_ON_BASELINE=true

# Send a notification when a target cannot be scraped.
NOTIFY_ON_ERROR=true

# --- Scraper ---------------------------------------------------------------
# HTTP timeout in seconds.
REQUEST_TIMEOUT=20

# --- Logging ---------------------------------------------------------------
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
